// Project-wide build settings for both configurations (PLAN.md §3: arm64 only,
// Swift 6; D2: macOS 15 minimum). Debug/Release differences stay in the project file.

ALWAYS_SEARCH_USER_PATHS = NO
ARCHS = arm64
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
COPY_PHASE_STRIP = NO
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
MACOSX_DEPLOYMENT_TARGET = 15.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
